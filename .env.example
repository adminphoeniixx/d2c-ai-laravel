APP_NAME=Pulsara
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (Postgres via Docker) ───────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pulsara
DB_USERNAME=pulsara
DB_PASSWORD=secret

# ─── Session / Queue / Cache ───────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Redis (optional, for Phase 4+) ───────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@pulsara.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Reverb (WebSockets, Phase 4+) ────────────────
REVERB_APP_ID=pulsara
REVERB_APP_KEY=pulsara-key
REVERB_APP_SECRET=pulsara-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ─── Multi-tenancy ────────────────────────────────
TENANT_ROUTE_PREFIX=app
ADMIN_ROUTE_PREFIX=admin
ADMIN_SEED_EMAIL=admin@pulsara.test
ADMIN_SEED_PASSWORD=password

# ─── Shopify OAuth (provide when ready) ───────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES="read_orders,read_products,read_customers,read_inventory,write_orders"
SHOPIFY_API_VERSION=2025-01

# ─── WooCommerce ──────────────────────────────────
WOO_APP_NAME="Pulsara D2C Ops"
WOO_SCOPE=read_write

VITE_APP_NAME="${APP_NAME}"
